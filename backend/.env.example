# ============================================================
# NodePanel backend — environment
# Salin ke .env lalu isi nilainya. JANGAN commit .env ke git.
# ============================================================

NODE_ENV=development
PORT=2087
HOST=0.0.0.0
LOG_LEVEL=info

# --- Database (MySQL 8) ---
DATABASE_URL="mysql://nodepanel:change-me@127.0.0.1:3306/nodepanel"

# --- Redis (opsional; dipakai Bull queue SSL & backup) ---
# Kosongkan untuk menjalankan queue secara inline (tanpa Redis).
REDIS_URL=redis://127.0.0.1:6379

# --- Keamanan ---
# Wajib di production. Di development boleh kosong (akan dibuat otomatis).
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
PANEL_CRYPTO_KEY=
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30
BCRYPT_ROUNDS=12

# --- Origin ---
# Origin frontend (Vite dev server) untuk CORS.
WEB_ORIGIN=http://localhost:5173
# URL publik panel, dipakai untuk link reset & callback.
PANEL_URL=http://localhost:2087

# --- Root filesystem yang dikelola panel ---
PANEL_WEB_ROOT=/var/www
PANEL_HOME_ROOT=/home
# Daftar root yang boleh diakses File Manager (pisahkan koma).
# Untuk development lokal, gunakan direktori workspace:
# PANEL_FILE_ROOTS=./data/www
PANEL_FILE_ROOTS=/var/www,/home

# --- Nginx ---
NGINX_AVAILABLE_DIR=/etc/nginx/sites-available
NGINX_ENABLED_DIR=/etc/nginx/sites-enabled
NGINX_CONF=/etc/nginx/nginx.conf

# --- SSL / Certbot ---
CERTBOT_EMAIL=admin@example.com
SSL_DIR=/etc/letsencrypt
# 1 = jangan menjalankan perintah sistem (nginx/certbot/systemctl).
# Dipakai untuk development & test di mesin tanpa service tersebut.
PANEL_DRY_RUN=0

# --- Upload ---
MAX_UPLOAD_MB=100

# ============================================================
# Contoh konfigurasi DEVELOPMENT lokal (mesin tanpa Nginx/root)
# Salin baris berikut ke .env lalu sesuaikan path-nya.
# ============================================================
# PANEL_DRY_RUN=1
# PANEL_WEB_ROOT=./data/www
# PANEL_HOME_ROOT=./data/home
# PANEL_FILE_ROOTS=./data/www
# NGINX_AVAILABLE_DIR=./data/nginx/sites-available
# NGINX_ENABLED_DIR=./data/nginx/sites-enabled
# NGINX_CONF=./data/nginx/nginx.conf
# SSL_DIR=./data/letsencrypt
# REDIS_URL=
